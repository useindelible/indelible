set dotenv-load

# List available recipes
default:
    @just --list

# --- Build & Check ---

# Check all crates compile
check:
    cargo check --workspace

# Check a single crate
check-crate crate:
    cargo check -p {{crate}}

# Run clippy on the workspace
lint:
    cargo clippy --workspace -- -D warnings

# Format all code
fmt:
    cargo fmt --all

# Format check (CI)
fmt-check:
    cargo fmt --all -- --check

# --- Test ---

# Run all tests
test:
    cargo test --workspace

# Run tests for a single crate
test-crate crate:
    cargo test -p {{crate}}

# --- Database ---

# Run migrations against the local database
db-migrate:
    cargo sqlx migrate run --source crates/ind-persistence/migrations

# Revert last migration
db-revert:
    cargo sqlx migrate revert --source crates/ind-persistence/migrations

# Check migration status
db-status:
    cargo sqlx migrate info --source crates/ind-persistence/migrations

# Refresh sqlx offline query cache from the live database.
# Requires a running Postgres (see .env for DATABASE_URL).
# Run this after adding or changing any sqlx query_as!/query! calls.
db-prepare:
    SQLX_OFFLINE=false cargo sqlx prepare --workspace -- --all-targets --all-features

# --- Run ---

# Run the API server
serve:
    cargo run -p ind-api

# Run the background worker
worker:
    cargo run -p ind-worker

# --- Dev Shortcuts ---

# Check + lint + test (pre-push gate)
pre-push: check lint test

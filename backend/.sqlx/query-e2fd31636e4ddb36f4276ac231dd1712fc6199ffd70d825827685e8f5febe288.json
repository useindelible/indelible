{
  "db_name": "PostgreSQL",
  "query": "INSERT INTO webhook_dispatches (id, domain_event_id, endpoint_id, event_type, status, first_enqueued_at, created_at, updated_at) SELECT gen_random_uuid(), $1, e.id, $2, 'pending', $4, $4, $4 FROM webhook_endpoints e WHERE e.user_id = $3 AND e.is_active = true AND $2 = ANY(e.events) ON CONFLICT (domain_event_id, endpoint_id) DO NOTHING RETURNING id, domain_event_id, endpoint_id, event_type, status, first_enqueued_at, delivered_at, exhausted_at, last_error, created_at, updated_at",

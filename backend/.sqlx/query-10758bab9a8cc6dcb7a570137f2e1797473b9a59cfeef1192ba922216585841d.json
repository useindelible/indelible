  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, user_id, destination, local_part, status, is_default,\n                   created_at, retire_at, retired_at\n            FROM email_aliases\n            WHERE destination = $1\n              AND local_part = $2\n              AND status = 'active'\n              AND (retire_at IS NULL OR retire_at > now())\n            ",

  "query": "SELECT h.id, h.text_content AS text, h.color, h.created_at, hn.body AS \"note?\"\n               FROM highlights h\n               LEFT JOIN highlight_notes hn ON hn.highlight_id = h.id\n               WHERE h.document_id = $1 AND h.user_id = $2\n               ORDER BY h.created_at, h.id",

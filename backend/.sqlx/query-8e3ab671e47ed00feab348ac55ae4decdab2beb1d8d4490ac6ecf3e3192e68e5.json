{
  "db_name": "PostgreSQL",
  "query": "INSERT INTO highlight_notes (id, highlight_id, body, created_at, updated_at) SELECT $1, h.id, $3, $4, $4 FROM highlights h WHERE h.id = $2 AND h.user_id = $5 ON CONFLICT (highlight_id) DO UPDATE SET body = EXCLUDED.body, updated_at = EXCLUDED.updated_at RETURNING id, highlight_id, body, created_at, updated_at",

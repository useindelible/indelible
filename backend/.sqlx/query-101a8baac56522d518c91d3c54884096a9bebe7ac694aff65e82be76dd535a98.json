{
  "db_name": "PostgreSQL",
  "query": "SELECT id, document_id AS \"document_id!\", user_id, color, text_content, locator, source_locator, created_at, updated_at\n               FROM highlights\n               WHERE document_id = $1\n                 AND user_id = $2\n                 AND (\n                       $3::timestamptz IS NULL\n                       OR created_at > $3\n                       OR (created_at = $3 AND id > $4::uuid)\n                     )\n               ORDER BY created_at ASC, id ASC\n               LIMIT $5",

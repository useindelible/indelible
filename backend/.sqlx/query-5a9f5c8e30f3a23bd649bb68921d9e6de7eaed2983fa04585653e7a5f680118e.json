{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, document_id AS \"document_id!\", output_type, content, ai_run_id, created_at\n            FROM ai_outputs\n            WHERE document_id = $1\n              AND ($2::text IS NULL OR output_type = $2)\n            ORDER BY created_at DESC, id DESC\n            ",

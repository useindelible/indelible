{
  "db_name": "PostgreSQL",
  "query": "SELECT le.document_id AS id, d.document_type AS item_type, d.title, d.excerpt, d.original_url AS url, d.domain, d.author, NULL::int AS reading_time_minutes, d.lead_image_url, uds.progress_percent::real AS \"progress_percent?\", uds.max_progress_percent::real AS \"max_progress_percent?\", uds.last_read_at, le.created_at FROM library_entries le JOIN documents d ON d.id = le.document_id AND d.user_id = le.user_id LEFT JOIN user_document_state uds ON uds.user_id = le.user_id AND uds.document_id = le.document_id WHERE le.user_id = $1 AND le.deleted_at IS NULL AND d.document_type = 'article' AND uds.last_read_at IS NULL ORDER BY le.created_at DESC LIMIT $2",

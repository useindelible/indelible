{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                user_id,\n                raw_query,\n                normalized_query,\n                last_searched_at,\n                created_at,\n                updated_at\n            FROM recent_searches\n            WHERE user_id = $1\n              AND normalized_query LIKE $2\n            ORDER BY last_searched_at DESC, updated_at DESC\n            LIMIT $3\n            ",

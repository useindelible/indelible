  "query": "\n            UPDATE entities\n            SET name = COALESCE($3::text, name),\n                description = CASE WHEN $4::boolean THEN $5::text ELSE description END\n            WHERE id = $1\n              AND user_id = $2\n            RETURNING id, user_id, name, entity_type, description, created_at\n            ",

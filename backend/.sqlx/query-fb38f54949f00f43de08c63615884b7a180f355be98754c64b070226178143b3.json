  "query": "SELECT id, user_id, parent_id, name, description, icon, color, sort_order, is_pinned, rss_token, created_at, updated_at FROM collections WHERE user_id = $1 AND (($2::uuid IS NULL AND parent_id IS NULL) OR parent_id = $2) AND lower(name) = lower($3) ORDER BY created_at ASC LIMIT 1",

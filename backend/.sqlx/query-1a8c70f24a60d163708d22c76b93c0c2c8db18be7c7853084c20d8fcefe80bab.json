  "query": "SELECT ht.highlight_id, t.id, t.user_id, t.name, t.color, t.parent_id, t.created_at FROM tags t JOIN highlight_tags ht ON ht.tag_id = t.id JOIN highlights h ON h.id = ht.highlight_id WHERE ht.highlight_id = ANY($1) AND h.user_id = $2 ORDER BY ht.highlight_id ASC, t.name ASC",

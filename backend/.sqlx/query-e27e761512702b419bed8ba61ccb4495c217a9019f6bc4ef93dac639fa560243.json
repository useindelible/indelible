  "db_name": "PostgreSQL",
  "query": "UPDATE collections SET name = COALESCE($3, name), description = CASE WHEN $4 THEN $5 ELSE description END, icon = CASE WHEN $6 THEN $7 ELSE icon END, color = CASE WHEN $8 THEN $9 ELSE color END, sort_order = COALESCE($10, sort_order), parent_id = CASE WHEN $11 THEN $12 ELSE parent_id END, updated_at = now() WHERE id = $1 AND user_id = $2 RETURNING id, user_id, parent_id, name, description, icon, color, sort_order, is_pinned, rss_token, created_at, updated_at",

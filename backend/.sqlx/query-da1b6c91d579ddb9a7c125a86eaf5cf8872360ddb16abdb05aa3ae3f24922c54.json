  "query": "\n            SELECT id, job_type, payload, dedupe_key, available_at, dispatched_at, created_at\n            FROM job_outbox\n            WHERE job_type = $1\n            ORDER BY (dedupe_key = $2) DESC, created_at DESC\n            LIMIT 1\n            FOR UPDATE\n            ",

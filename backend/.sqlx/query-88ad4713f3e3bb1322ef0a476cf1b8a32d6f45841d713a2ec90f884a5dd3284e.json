  "query": "SELECT\n                   iji.id,\n                   iji.import_job_id,\n                   iji.external_id,\n                   NULL::text AS \"title?\",\n                   iji.outcome,\n                   iji.error,\n                   iji.created_at\n               FROM import_job_items iji\n               WHERE iji.import_job_id = $1\n               ORDER BY iji.created_at ASC\n               LIMIT $2 OFFSET $3",

  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, user_id, name, action, system_prompt, is_default, is_system, created_at\n            FROM ai_prompt_presets\n            WHERE user_id = $1\n              AND action = $2\n              AND is_default = true\n              AND is_system = false\n            ORDER BY created_at DESC\n            LIMIT 1\n            ",

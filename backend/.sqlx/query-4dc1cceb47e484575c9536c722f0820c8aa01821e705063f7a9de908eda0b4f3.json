{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                m.id,\n                m.session_id,\n                m.role,\n                m.content,\n                m.source_chunks as \"source_chunks!: Vec<Uuid>\",\n                m.created_at\n            FROM mila_messages m\n            JOIN mila_sessions s ON s.id = m.session_id\n            WHERE m.session_id = $1\n              AND s.user_id = $2\n            ORDER BY m.created_at ASC, m.id ASC\n            ",

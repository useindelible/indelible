  "query": "INSERT INTO item_notes (id, document_id, user_id, body, created_at, updated_at) VALUES ($1, $2, $3, $4, $5, $5) ON CONFLICT (user_id, document_id) WHERE document_id IS NOT NULL DO UPDATE SET body = EXCLUDED.body, updated_at = EXCLUDED.updated_at RETURNING id, document_id AS \"document_id!\", user_id, body, created_at, updated_at",

  "query": "\n            SELECT id, user_id, canonical_addr, list_id, display_name,\n                   render_default, routing_default, blocked_at,\n                   first_seen_at, last_seen_at, delivery_count,\n                   created_at, updated_at\n            FROM email_senders\n            WHERE user_id = $1\n            ORDER BY last_seen_at DESC, id DESC\n            OFFSET $2\n            LIMIT $3\n            ",

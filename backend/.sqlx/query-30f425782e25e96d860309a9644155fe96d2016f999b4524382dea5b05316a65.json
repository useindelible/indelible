  "query": "\n            SELECT id, job_type, payload, dedupe_key, available_at\n            FROM job_outbox\n            WHERE dispatched_at IS NULL\n              AND available_at <= now()\n            ORDER BY available_at, created_at\n            LIMIT $1\n            FOR UPDATE SKIP LOCKED\n            ",

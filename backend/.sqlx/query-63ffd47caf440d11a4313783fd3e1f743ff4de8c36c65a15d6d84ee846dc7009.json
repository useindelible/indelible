{
  "db_name": "PostgreSQL",
  "query": "SELECT ht.added_at AS link_added_at, h.id, h.document_id AS \"document_id!\", h.user_id, h.color, h.text_content, h.locator, h.source_locator, h.created_at, h.updated_at FROM highlights h JOIN highlight_tags ht ON ht.highlight_id = h.id WHERE ht.tag_id = $1 AND h.user_id = $2 AND h.document_id IS NOT NULL AND (ht.added_at, h.id) < ($3, $4) ORDER BY ht.added_at DESC, h.id DESC LIMIT $5",

DATABASE_URL=postgres://indelible:indelible@localhost:5439/indelible
IND_PORT=38473
IND_BASE_URL=http://localhost:38473
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=indelible
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Optional: set false to disable new signups after you've created your
# account(s). The first account can always be created on an empty instance.
AUTH_ALLOW_SIGNUPS=true

# Optional: generic OIDC SSO for authentik, ZITADEL, and similar IdPs.
# For local authentik testing, copy .env.authentik.example into your .env
# or pass it with `docker compose --env-file .env.authentik up -d`.
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:9080/application/o/indelible/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=OpenID Connect
OIDC_SCOPES=openid,email,profile
OIDC_AUTO_CREATE_USERS=true

# -- Credential cipher key (required for integration OAuth token storage) --
# 32-byte random key, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts stored integration OAuth tokens (e.g. Notion). REQUIRED in production
# whenever an integration is configured (NOTION_CLIENT_ID set); startup fails
# closed without it. Set the SAME value on BOTH ind-api and ind-worker: the API
# stores the encrypted tokens and the worker decrypts them for sync/export.
AUTH_CREDENTIAL_KEY=

# -- Notion integration (TASK-198) --
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URL=http://localhost:38473/api/v1/integrations/notion/callback

# -- Email ingestion --
# Inbound email addresses are formed as `<token>@$EMAIL_FEED_DOMAIN` (newsletter
# feed) and `<token>@$EMAIL_LIBRARY_DOMAIN` (one-off library forwards). These
# defaults match the Indelible-hosted SaaS; self-hosters override per-deployment.
EMAIL_FEED_DOMAIN=feed.useindelible.com
EMAIL_LIBRARY_DOMAIN=library.useindelible.com
EMAIL_INGEST_PROVIDER=resend
EMAIL_INGEST_WEBHOOK_SECRET=
RESEND_API_KEY=

# -- Outbound egress / SSRF guard --
# All server-side fetches of user-supplied URLs (article ingest, feeds, the
# Chromium renderer, AI providers, webhook delivery) refuse private, loopback,
# link-local, and cloud-metadata targets. The DEFAULT depends on IND_ENV:
# development defaults this ON (so a local AI/feed/renderer endpoint such as
# Ollama at http://localhost:11434 works out of the box); production/staging
# default it OFF. This env var overrides the default in either direction.
# Hosted SaaS keeps this OFF. Self-hosters set it true only to reach a local
# renderer/feed/AI endpoint, and must network-isolate those services.
# Set this on BOTH ind-api and ind-worker (and ind-renderer) for consistency.
EGRESS_ALLOW_PRIVATE_TARGETS=false
# Allow webhook *delivery* to private endpoints (creation + delivery). Off by
# default; honored in addition to EGRESS_ALLOW_PRIVATE_TARGETS.
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# -- Reverse-proxy / client IP trust --
# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For /
# X-Real-IP headers we trust to carry the real client IP. Leave EMPTY when the
# app is exposed directly (rate limiting then keys on the socket peer). Set this
# to your proxy/CDN ranges when running behind nginx/Caddy/Cloudflare/CloudFront,
# otherwise a client can spoof its IP to evade auth rate limits.
# Example: TRUSTED_PROXIES=10.0.0.0/8,2001:db8::/32
TRUSTED_PROXIES=

# JWT secret rotation (M.4): access tokens are short-lived (15 min) and signed
# with a single static JWT_SECRET. To rotate, deploy the new secret during a
# low-traffic window; outstanding access tokens become invalid (clients
# transparently re-auth via the refresh cookie). No dual-key support in v1.

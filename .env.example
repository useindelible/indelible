# Indelible environment template.
#
# Copy to `.env` and it boots a local development instance as-is. The binaries
# load `.env` themselves (dotenvy), so no export step is needed.
#
# This file covers the development quickstart plus everything production needs.
# It is deliberately not exhaustive: Mila, TTS, worker scheduling, retention, and
# rate limits all have documented defaults, and the full reference lives at
# https://useindelible.com/docs/reference/configuration/
#
# One loader rule that bites: `KEY=` with an empty value is NOT the same as
# omitting KEY. An empty value is read as a present-but-empty setting, which
# satisfies "is this configured?" checks and then fails later with a confusing
# error. Leave a variable commented out unless you are giving it a real value.

DATABASE_URL=postgres://indelible:indelible@localhost:5439/indelible
IND_PORT=38473
IND_BASE_URL=http://localhost:38473
# Exact browser Identity callback URLs, comma-separated. Setting this replaces
# the built-in Chrome and Firefox callbacks. Edge and private-build values have the form
# https://<extension-id>.chromiumapp.org/indelible and must match the installed build.
#EXTENSION_REDIRECT_URIS=https://lblngpkieoichinegfhgacmcjbahjbek.chromiumapp.org/indelible,https://<edge-id>.chromiumapp.org/indelible,https://38bd18db5de5caccb6ab6c1271fec03ec1662d5c.extensions.allizom.org/indelible

# Development keeps auth cookies non-Secure, accepts the built-in placeholder
# secrets, and defaults the SSRF egress guard open for private targets. Set this
# to `production` on a real deployment and read the production block below: the
# server refuses to boot if the production-only variables are missing.
IND_ENV=development

# Object storage. Setting S3_ENDPOINT implicitly enables S3, so commenting it out
# also disables object storage; set S3_ENABLED explicitly if you want that
# decoupled. S3_ENABLED=true without an endpoint is a boot error.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=siloadmin
S3_SECRET_KEY=siloadmin
S3_BUCKET=indelible
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Largest single file accepted by a library upload, in bytes (default 50 MiB).
#UPLOAD_MAX_BYTES=52428800
# Maximum total size of a Readwise import bundle, including its optional OPML file, in bytes (default 200 MiB).
#IMPORT_UPLOAD_MAX_BYTES=209715200

# Signups close automatically once the first account exists, so a fresh
# instance still gets its owner with nothing to switch off afterwards.
# Set this to true only while you are letting additional people register.
AUTH_ALLOW_SIGNUPS=false

# ---------------------------------------------------------------------------
# Required in production (IND_ENV=production)
# ---------------------------------------------------------------------------
# Every variable in this block is enforced at boot. The server exits rather than
# starting in an insecure state, so fill these in before deploying.
#
# IND_BASE_URL and FRONTEND_URL must both use https: the refresh cookie is
# Secure, so browsers silently discard it over plain http and sessions die on
# their first refresh.
#
#IND_BASE_URL=https://indelible.example.com
#FRONTEND_URL=https://indelible.example.com
# Comma-separated. List every hostname that reaches this instance (a LAN name and
# a tailnet name, say); session refresh accepts any configured origin.
#CORS_ORIGINS=https://indelible.example.com
#
# Generate each of these separately: openssl rand -hex 32
#CSRF_SECRET=
#JWT_SECRET=
# Signs the short-lived cookies used to stream archived files through the API.
# Required whenever ASSET_SERVING_MODE is passthrough, which is the default.
# Must be at least 64 characters: openssl rand -hex 32
#ASSET_COOKIE_SECRET=

# How archived files (images, PDFs, saved pages) reach the browser. API
# responses always contain API URLs; this only changes how those URLs answer.
# passthrough (default): the API streams the bytes, so the object store stays
# private on the internal network. presigned: asset downloads redirect (302)
# to short-lived signed URLs pointing at S3_ENDPOINT, which then has to be a
# browser-reachable TLS address (e.g. real AWS S3). Uploads always go through
# the API in both modes.
#ASSET_SERVING_MODE=passthrough

# Access tokens are short-lived (15 min) and signed with a single static
# JWT_SECRET. To rotate, deploy the new secret during a low-traffic window;
# outstanding access tokens become invalid and clients transparently re-auth via
# the refresh cookie. There is no dual-key support.

# ---------------------------------------------------------------------------
# Credential cipher key
# ---------------------------------------------------------------------------
# Encrypts stored integration OAuth tokens and signs outgoing webhooks. Set the
# SAME value on BOTH ind-api and ind-worker: the API stores the encrypted tokens
# and the worker decrypts them for sync and export.
#
# Must be exactly 32 random bytes, base64-encoded: openssl rand -base64 32
# An empty value is worse than an absent one: it fails at startup with
# "invalid credential key". Leave it commented out until you have a real key.
#AUTH_CREDENTIAL_KEY=

# ---------------------------------------------------------------------------
# Optional integrations. Uncomment a block only when you configure it
# ---------------------------------------------------------------------------
# Generic OIDC SSO for authentik, ZITADEL, and similar IdPs.
OIDC_ENABLED=false
#OIDC_ISSUER_URL=http://localhost:9080/application/o/indelible/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_PROVIDER_NAME=OpenID Connect
#OIDC_SCOPES=openid,email,profile
#OIDC_AUTO_CREATE_USERS=true

# Notion export/sync. Needs AUTH_CREDENTIAL_KEY set above.
#NOTION_CLIENT_ID=
#NOTION_CLIENT_SECRET=
#NOTION_REDIRECT_URL=http://localhost:38473/api/v1/integrations/notion/callback

# Inbound email. Addresses are formed as `<token>@$EMAIL_FEED_DOMAIN` (newsletter
# feed) and `<token>@$EMAIL_LIBRARY_DOMAIN` (one-off library forwards). Leave the
# whole block commented until you control the domains AND have provider
# credentials: setting only the domains advertises capture addresses that can
# never receive mail. The provider is validated at boot.
#EMAIL_FEED_DOMAIN=
#EMAIL_LIBRARY_DOMAIN=
#EMAIL_INGEST_PROVIDER=resend
#EMAIL_INGEST_WEBHOOK_SECRET=
#RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Outbound egress / SSRF guard
# ---------------------------------------------------------------------------
# All server-side fetches of user-supplied URLs (article ingest, feeds, the
# Chromium renderer, AI providers, webhook delivery) refuse private, loopback,
# link-local, and cloud-metadata targets. Set true to reach services on the
# machine hosting the containers — from inside Docker that machine is
# http://host.docker.internal, NOT localhost (which is the container itself),
# so a host-side Ollama is http://host.docker.internal:11434.
# Left unset here on purpose: the source docker-compose.yml is a local
# development stack and defaults it ON so that path works, while the published
# quickstart defaults it OFF. Uncomment and set it explicitly — false for any
# deployment reachable from a network — to override either default.
# Set this on ind-api, ind-worker, and ind-renderer alike.
#EGRESS_ALLOW_PRIVATE_TARGETS=false
# Allow webhook *delivery* to private endpoints (creation and delivery). Off by
# default; honoured in addition to EGRESS_ALLOW_PRIVATE_TARGETS.
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# ---------------------------------------------------------------------------
# Reverse-proxy / client IP trust
# ---------------------------------------------------------------------------
# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For and
# X-Real-IP headers we trust to carry the real client IP. Leave this commented
# out when the app is exposed directly (rate limiting then keys on the socket
# peer). Set it to your proxy or CDN ranges when running behind
# nginx/Caddy/Cloudflare/CloudFront, otherwise a client can spoof its IP to evade
# auth rate limits.
#TRUSTED_PROXIES=10.0.0.0/8,2001:db8::/32

# ---------------------------------------------------------------------------
# Serving the web app
# ---------------------------------------------------------------------------
# ind-api serves the built SPA from this directory, falling back to index.html so
# client-side routes survive a refresh. The published image sets /app/web; for a
# local `cargo run` from backend/, point it at your `web/build` output.
#WEB_ROOT=./web

---
/**
 * The publisher's own masthead.
 *
 * A stylised likeness, not a facsimile. Its job is to make the frame read as
 * somebody else's website rather than another Indelible surface — that
 * contrast is the whole point of the extension section.
 */
import BrowserIcon from './BrowserIcon.astro';
---

<div class="xt-mast">
	<div class="xt-mrow">
		<div>
			<div class="xt-word"><b>towards</b><span>data science</span></div>
			<div class="xt-tag">
				Publish AI, ML &amp; data-science insights to a global community of data
				professionals.
			</div>
		</div>
		<div class="xt-mright">
			<span class="xt-signin">Sign in</span>
			<span class="xt-submit">Submit an Article</span>
		</div>
	</div>

	<div class="xt-mnav">
		<span>Latest</span><span>Editor&rsquo;s picks</span><span>Deep dives</span>
		<span>Newsletter</span><span class="bar"></span><span>Write for TDS</span>
		<span class="soc">
			<BrowserIcon name="li" />
			<BrowserIcon name="x" />
			<BrowserIcon name="mag" />
		</span>
	</div>
</div>

---
/** The Indelible favicon, geometry from website/public/favicon.svg. */
interface Props {
	size?: number;
}
const { size = 22 } = Astro.props;
---

<svg viewBox="0 0 200 200" width={size} height={size} aria-hidden="true">
	<rect x="20" y="20" width="160" height="160" rx="42" fill="var(--acc)"></rect>
	<g fill="#ffffff">
		<rect x="88" y="38" width="24" height="52" rx="10"></rect>
		<rect x="88" y="110" width="24" height="52" rx="10"></rect>
		<rect x="38" y="88" width="52" height="24" rx="10"></rect>
		<rect x="110" y="88" width="52" height="24" rx="10"></rect>
	</g>
	<circle cx="100" cy="100" r="26" fill="#ffffff"></circle>
	<circle cx="100" cy="100" r="11" fill="var(--acc)"></circle>
</svg>

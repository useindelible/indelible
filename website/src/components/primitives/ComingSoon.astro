---
/**
 * A feature that is announced but not live.
 *
 * The muted treatment is the point: it must never read as available. The same
 * rule governs the disabled Follow button inside the product screens.
 */
---

<span class="soon"><slot /></span>

<style>
	.soon {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 12px 20px;
		border: 1px solid var(--line-2);
		border-radius: var(--r);
		font-size: 14px;
		font-weight: 500;
		color: var(--faint);
	}

	.soon::after {
		content: 'Soon';
		padding: 2px 6px;
		border: 1px solid var(--amber);
		border-radius: 2px;
		color: var(--amber);
		font-family: var(--f-m);
		font-size: 9.5px;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}
</style>

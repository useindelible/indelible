---
/** The wordmark. Used by the header and the footer, so it lives here once. */
import Mark from './Mark.astro';

interface Props {
	size?: 'md' | 'sm';
	href?: string;
	class?: string;
}
const { size = 'md', href = '/', class: className } = Astro.props;

/* Brand blue, pinned rather than themed. The chrome around it is monochrome,
   so the mark is the only saturated thing on the page and has to stay the same
   blue as the favicon, the app and the logo files — a mark that changes colour
   with the page is a shape, not a mark. */
const BRAND_BLUE = '#0071e3';
---

<a class:list={['brand', `brand-${size}`, className]} href={href}>
	<Mark size={size === 'sm' ? 22 : 25} fill={BRAND_BLUE} />
	<span class="word">Indelible</span>
</a>

<style>
	.brand {
		display: flex;
		align-items: center;
		gap: 11px;
		flex: none;
	}

	.word {
		font-family: var(--f-d);
		font-size: 19px;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.brand-sm {
		gap: 10px;
	}

	.brand-sm .word {
		font-size: 17px;
	}
</style>

---
/** Small accent kicker with a leading rule. */
---

<div class="eyebrow"><s></s><slot /></div>

<style>
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		font-family: var(--f-m);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.eyebrow s {
		width: 24px;
		height: 1px;
		flex: none;
		background: currentColor;
		opacity: 0.55;
		text-decoration: none;
	}
</style>

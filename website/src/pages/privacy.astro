---
/**
 * The privacy policy.
 *
 * Prose only: it borrows the site's header, footer and type scale rather than
 * defining a look of its own, so a theme change reaches it too.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Wrap from '../components/primitives/Wrap.astro';
---

<BaseLayout
	title="Privacy Policy | Indelible"
	description="Privacy policy for the Indelible website, browser extension, and mobile apps."
	path="/privacy"
>
	<SiteHeader />

	<main>
		<Wrap class="policy">
			<h1>Privacy Policy</h1>
			<p class="meta">Effective July 29, 2026</p>

			<p>
				This policy covers the useindelible.com website, the Indelible browser extension, and
				the Indelible mobile apps, all maintained by CoreAxel.
			</p>

			<h2>The short version</h2>
			<p>
				Indelible is self-hosted software. We do not operate servers that receive, store, or
				process your content. Everything you save with Indelible goes to a server that you run
				and control. We collect nothing.
			</p>

			<h2>This website</h2>
			<p>
				useindelible.com is a static site. It uses no analytics, no advertising, no tracking
				cookies, and no third-party scripts. The site is served by Cloudflare, which may keep
				standard request logs for delivery and security purposes under{' '}
				<a href="https://www.cloudflare.com/privacypolicy/">Cloudflare's privacy policy</a>.
			</p>

			<h2>Browser extension</h2>
			<p>
				The extension connects to one server: the Indelible instance whose address you enter in
				its settings. It sends nothing to us or to any other third party.
			</p>
			<ul>
				<li>
					<strong>Stored on your device:</strong> your server address and an API token, kept in
					your browser's extension storage. Both are removed when you uninstall the extension.
				</li>
				<li>
					<strong>Sent to your server:</strong> when you choose to save a page, the extension
					sends that page's URL, title, and captured content to your configured instance.
					Nothing is captured or transmitted until you act.
				</li>
				<li>
					<strong>Permissions:</strong> reading the active tab and running the capture script
					are needed to snapshot the page you save, the context menu adds a right-click save
					action, and storage holds your settings. None of these are used for tracking.
				</li>
			</ul>

			<h2>Mobile apps</h2>
			<p>
				The Android and iOS apps follow the same model. Your credentials are stored on your
				device, and your library syncs only with the server address you configure. The apps
				contain no analytics or advertising SDKs.
			</p>

			<h2>Your self-hosted server</h2>
			<p>
				Content you save lives on infrastructure you control. Some optional features contact
				external services, and only when you configure them: the Mila assistant sends document
				content to the AI provider you supply credentials for, email ingestion uses the email
				domain you set up, and integrations such as Notion connect to accounts you link. If you
				never configure them, no external service is contacted.
			</p>

			<h2>Data retention and deletion</h2>
			<p>
				Retention is entirely under your control. Deleting an item, or your whole instance,
				removes it from your server. We hold no copy to delete.
			</p>

			<h2>Changes and contact</h2>
			<p>
				Changes to this policy are published on this page with an updated effective date.
				Questions are welcome on{' '}
				<a href="https://github.com/useindelible/indelible">GitHub</a>.
			</p>
		</Wrap>
	</main>

	<SiteFooter />
</BaseLayout>

<style>
	/* Clears the fixed nav pill (56px + its 14px gutter) with room to breathe. */
	.policy {
		max-width: 720px;
		padding-top: 150px;
		padding-bottom: 120px;
	}

	.policy h1 {
		font-family: var(--f-d);
		font-size: 40px;
		font-weight: 500;
		letter-spacing: -0.02em;
		margin-bottom: 8px;
	}

	.policy .meta {
		margin-bottom: 40px;
		font-family: var(--f-m);
		font-size: 13px;
		color: var(--faint);
	}

	.policy h2 {
		margin: 40px 0 12px;
		font-family: var(--f-d);
		font-size: 24px;
		font-weight: 500;
		letter-spacing: -0.015em;
	}

	.policy p,
	.policy li {
		font-size: 15px;
		line-height: 1.7;
		color: var(--dim);
	}

	.policy p + p {
		margin-top: 12px;
	}

	.policy ul {
		display: grid;
		gap: 10px;
		margin-top: 12px;
		padding-left: 20px;
	}

	.policy strong {
		color: var(--ink);
		font-weight: 600;
	}

	.policy a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>

# Indelible local trial. Append generated secrets with:
#
#   {
#     echo "POSTGRES_PASSWORD=$(openssl rand -hex 16)"
#     echo "MINIO_ROOT_PASSWORD=$(openssl rand -hex 16)"
#     echo "JWT_SECRET=$(openssl rand -hex 32)"
#     echo "CSRF_SECRET=$(openssl rand -hex 32)"
#     echo "ASSET_COOKIE_SECRET=$(openssl rand -hex 32)"
#     echo "AUTH_CREDENTIAL_KEY=$(openssl rand -base64 32)"
#   } >> .env
#
# Every generated secret above is required. Leaving one blank is worse than
# omitting it: an empty value counts as configured and fails later with a
# confusing error.
# AUTH_CREDENTIAL_KEY must be exactly 32 random bytes, base64-encoded.
# The other secrets have no length requirement beyond 64 hex characters for
# ASSET_COOKIE_SECRET, which `openssl rand -hex 32` satisfies.

# The source template follows the newest stable release. Files attached to a
# GitHub Release pin this value to that exact release instead.
INDELIBLE_VERSION=latest

# Set true to let Indelible reach services on this machine — required for a
# local AI server such as Ollama, whose address from inside the containers is
# http://host.docker.internal:11434 (localhost would be the container itself).
# Leave it off for any stack reachable from a network.
#EGRESS_ALLOW_PRIVATE_TARGETS=true

# Exact browser Identity callbacks accepted by the extension PKCE flow.
# Include every Chrome, Edge, and Firefox build you distribute.
#EXTENSION_REDIRECT_URIS=https://jidilhjojlgndbpeooeeceohmkedooef.chromiumapp.org/indelible,https://<edge-id>.chromiumapp.org/indelible,https://38bd18db5de5caccb6ab6c1271fec03ec1662d5c.extensions.allizom.org/indelible

# Largest single file accepted by a library upload, in bytes (default 50 MiB).
#UPLOAD_MAX_BYTES=52428800
# Maximum total size of a Readwise import bundle, including its optional OPML file, in bytes (default 200 MiB).
#IMPORT_UPLOAD_MAX_BYTES=209715200

# Indelible local trial. Append generated secrets with:
#
#   {
#     echo "POSTGRES_PASSWORD=$(openssl rand -hex 16)"
#     echo "MINIO_ROOT_PASSWORD=$(openssl rand -hex 16)"
#     echo "JWT_SECRET=$(openssl rand -hex 32)"
#     echo "CSRF_SECRET=$(openssl rand -hex 32)"
#     echo "ASSET_COOKIE_SECRET=$(openssl rand -hex 32)"
#     echo "AUTH_CREDENTIAL_KEY=$(openssl rand -base64 32)"
#   } >> .env
#
# Every value below is required. Leaving one blank is worse than removing the
# line: an empty value counts as configured and fails later with a confusing
# error.
#
# AUTH_CREDENTIAL_KEY must be exactly 32 random bytes, base64-encoded.
# The other secrets have no length requirement beyond 64 hex characters for
# ASSET_COOKIE_SECRET, which `openssl rand -hex 32` satisfies.

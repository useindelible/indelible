CREATE TABLE cached_document (
    scope TEXT NOT NULL,
    document_id TEXT NOT NULL,
    document_type TEXT NOT NULL,
    title TEXT NOT NULL,
    reader_json TEXT NOT NULL,
    pinned INTEGER NOT NULL DEFAULT 0,
    last_opened_at INTEGER NOT NULL,
    last_synced_at INTEGER,
    bytes INTEGER NOT NULL DEFAULT 0,
    generation INTEGER NOT NULL DEFAULT 0,
    note_body TEXT,
    note_server_updated_at INTEGER,
    progress_percent INTEGER,
    max_progress_percent INTEGER,
    PRIMARY KEY (scope, document_id)
);

CREATE TABLE cached_asset (
    scope TEXT NOT NULL,
    document_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    idx INTEGER NOT NULL DEFAULT 0,
    path TEXT NOT NULL,
    bytes INTEGER NOT NULL,
    PRIMARY KEY (scope, document_id, kind, idx)
);

CREATE TABLE cached_highlight (
    scope TEXT NOT NULL,
    id TEXT NOT NULL,
    document_id TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (scope, id)
);

CREATE TABLE outbox (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    scope TEXT NOT NULL,
    id TEXT NOT NULL,
    kind TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    document_id TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    last_attempt_at INTEGER,
    next_attempt_at INTEGER NOT NULL DEFAULT 0,
    state TEXT NOT NULL DEFAULT 'pending',
    last_error TEXT,
    superseded INTEGER NOT NULL DEFAULT 0
);
CREATE UNIQUE INDEX outbox_scope_id ON outbox(scope, id);
CREATE INDEX outbox_drain ON outbox(scope, state, next_attempt_at, seq);
CREATE INDEX outbox_entity ON outbox(scope, entity_id, seq);

CREATE TABLE client_state (
    scope TEXT NOT NULL PRIMARY KEY,
    client_id TEXT NOT NULL,
    next_origin_seq INTEGER NOT NULL DEFAULT 0,
    purge_pending INTEGER NOT NULL DEFAULT 0,
    profile_json TEXT
);

CREATE TABLE document_revision (
    scope TEXT NOT NULL,
    document_id TEXT NOT NULL,
    content_rev INTEGER NOT NULL DEFAULT 0,
    position_rev INTEGER NOT NULL DEFAULT 0,
    acked_progress_seq INTEGER NOT NULL DEFAULT -1,
    PRIMARY KEY (scope, document_id)
);

insertOutbox:
INSERT INTO outbox(scope, id, kind, entity_id, document_id, payload_json, created_at, state)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

pendingOrdered:
SELECT * FROM outbox WHERE scope = ? AND state = 'pending' AND superseded = 0 ORDER BY seq;

liveOutboxForDocument:
SELECT * FROM outbox WHERE scope = ? AND document_id = ? AND superseded = 0 ORDER BY seq;

supersedeField:
UPDATE outbox SET superseded = 1 WHERE scope = ? AND entity_id = ? AND kind = ? AND seq < ?;

supersedeHighlight:
UPDATE outbox SET superseded = 1
WHERE scope = ? AND entity_id = ? AND kind != 'highlight_create' AND seq < ?;

documentSyncCounts:
SELECT
  document_id,
  SUM(CASE WHEN state = 'pending' THEN 1 ELSE 0 END) AS pending,
  SUM(CASE WHEN state = 'pending' AND attempts > 0 THEN 1 ELSE 0 END) AS retrying,
  SUM(CASE WHEN state = 'failed' THEN 1 ELSE 0 END) AS failed,
  SUM(CASE WHEN state = 'blocked' THEN 1 ELSE 0 END) AS blocked
FROM outbox
WHERE scope = ? AND superseded = 0
GROUP BY document_id;

ensureRevision:
INSERT OR IGNORE INTO document_revision(scope, document_id) VALUES (?, ?);

bumpContentRevision:
UPDATE document_revision SET content_rev = content_rev + 1 WHERE scope = ? AND document_id = ?;

bumpPositionRevision:
UPDATE document_revision SET position_rev = position_rev + 1 WHERE scope = ? AND document_id = ?;

raiseAckedProgressSeq:
UPDATE document_revision SET acked_progress_seq = MAX(acked_progress_seq, :seq)
WHERE scope = :scope AND document_id = :document_id;

documentRevision:
SELECT * FROM document_revision WHERE scope = ? AND document_id = ?;

hasFailedCreate:
SELECT EXISTS(
  SELECT 1 FROM outbox
  WHERE scope = ? AND entity_id = ? AND kind = 'highlight_create' AND state = 'failed'
);

outboxByState:
SELECT * FROM outbox WHERE scope = ? AND state = ? ORDER BY seq;

deleteOutboxRow:
DELETE FROM outbox WHERE scope = ? AND id = ?;

markAttempt:
UPDATE outbox
SET attempts = attempts + 1, last_attempt_at = ?, next_attempt_at = ?, last_error = ?
WHERE scope = ? AND id = ?;

setState:
UPDATE outbox SET state = ?, last_error = ? WHERE scope = ? AND id = ?;

setStateForEntity:
UPDATE outbox SET state = ? WHERE scope = ? AND entity_id = ? AND state = ?;

resetForRetry:
UPDATE outbox
SET state = 'pending', attempts = 0, next_attempt_at = 0, last_error = NULL
WHERE scope = ? AND id = ?;

outboxForScope:
SELECT * FROM outbox WHERE scope = ? ORDER BY seq;

outboxForDocument:
SELECT * FROM outbox WHERE scope = ? AND document_id = ? ORDER BY seq;

outboxRow:
SELECT * FROM outbox WHERE scope = ? AND id = ?;

setDocumentSyncedAt:
UPDATE cached_document SET last_synced_at = ? WHERE scope = ? AND document_id = ?;

upsertCachedDocument:
INSERT OR REPLACE INTO cached_document(scope, document_id, document_type, title, reader_json, pinned, last_opened_at, last_synced_at, bytes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

touchDocumentOpened:
UPDATE cached_document SET last_opened_at = ? WHERE scope = ? AND document_id = ?;

setPinned:
UPDATE cached_document SET pinned = ? WHERE scope = ? AND document_id = ?;

setDocumentBytes:
UPDATE cached_document SET bytes = ? WHERE scope = ? AND document_id = ?;

installDocument:
INSERT OR REPLACE INTO cached_document(
    scope, document_id, document_type, title, reader_json, pinned, last_opened_at, last_synced_at, bytes,
    generation, note_body, note_server_updated_at, progress_percent, max_progress_percent
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

refreshDocumentMeta:
UPDATE cached_document SET title = ?, reader_json = ? WHERE scope = ? AND document_id = ?;

setCachedProgress:
UPDATE cached_document SET progress_percent = ?, max_progress_percent = ? WHERE scope = ? AND document_id = ?;

patchCachedProgress:
UPDATE cached_document
SET progress_percent = :percent, max_progress_percent = MAX(COALESCE(max_progress_percent, :percent), :percent)
WHERE scope = :scope AND document_id = :document_id;

setCachedNote:
UPDATE cached_document SET note_body = ? WHERE scope = ? AND document_id = ?;

setCachedServerNote:
UPDATE cached_document SET note_body = ?, note_server_updated_at = ? WHERE scope = ? AND document_id = ?;

catalog:
SELECT document_id, document_type, title, pinned, last_opened_at, last_synced_at, bytes, generation
FROM cached_document WHERE scope = ? ORDER BY last_opened_at DESC;

cachedDocuments:
SELECT * FROM cached_document WHERE scope = ? ORDER BY last_opened_at DESC;

cachedDocument:
SELECT * FROM cached_document WHERE scope = ? AND document_id = ?;

unpinnedLru:
SELECT * FROM cached_document WHERE scope = ? AND pinned = 0 ORDER BY last_opened_at ASC;

totalBytes:
SELECT SUM(bytes) FROM cached_document WHERE scope = ?;

insertCachedAsset:
INSERT INTO cached_asset(scope, document_id, kind, idx, path, bytes)
VALUES (?, ?, ?, ?, ?, ?);

assetsForDocument:
SELECT * FROM cached_asset WHERE scope = ? AND document_id = ?;

deleteAssetsForDocument:
DELETE FROM cached_asset WHERE scope = ? AND document_id = ?;

upsertCachedHighlight:
INSERT OR REPLACE INTO cached_highlight(scope, id, document_id, payload_json, updated_at)
VALUES (?, ?, ?, ?, ?);

deleteCachedHighlight:
DELETE FROM cached_highlight WHERE scope = ? AND id = ?;

deleteHighlightsForDocument:
DELETE FROM cached_highlight WHERE scope = ? AND document_id = ?;

deleteHighlightsWithoutLiveRows:
DELETE FROM cached_highlight
WHERE scope = :scope AND document_id = :document_id
  AND id NOT IN (SELECT entity_id FROM outbox WHERE scope = :scope AND superseded = 0);

highlightsForDocument:
SELECT * FROM cached_highlight WHERE scope = ? AND document_id = ?;

cachedHighlight:
SELECT * FROM cached_highlight WHERE scope = ? AND id = ?;

getClientState:
SELECT * FROM client_state WHERE scope = ?;

insertClientState:
INSERT INTO client_state(scope, client_id, next_origin_seq, purge_pending)
VALUES (?, ?, ?, ?);

setNextOriginSeq:
UPDATE client_state SET next_origin_seq = ? WHERE scope = ?;

setPurgePending:
UPDATE client_state SET purge_pending = ? WHERE scope = ?;

scopesWithState:
SELECT scope, purge_pending FROM client_state;

deleteCachedDocument:
DELETE FROM cached_document WHERE scope = ? AND document_id = ?;

purgeRows {
  DELETE FROM cached_document WHERE scope = :scope;
  DELETE FROM cached_asset WHERE scope = :scope;
  DELETE FROM cached_highlight WHERE scope = :scope;
  DELETE FROM outbox WHERE scope = :scope;
  DELETE FROM document_revision WHERE scope = :scope;
}

deleteClientState:
DELETE FROM client_state WHERE scope = ?;

TEAM_ID=

PRODUCT_NAME=indelible
PRODUCT_BUNDLE_IDENTIFIER=com.useindelible.app

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

KOTLIN_FRAMEWORK_BUILD_TYPE = debug
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../composeApp/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)" "$(SRCROOT)/../composeApp/build/xcode-frameworks/$(CONFIGURATION)/$(PLATFORM_NAME)"
OTHER_LDFLAGS = $(inherited) -framework ComposeApp

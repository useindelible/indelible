{
  "name": "ind-extension",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/copy-singlefile.js && wxt build",
    "build:edge": "node scripts/copy-singlefile.js && wxt build --browser edge",
    "build:firefox": "node scripts/copy-singlefile.js && wxt build --browser firefox --mv3",
    "zip": "node scripts/copy-singlefile.js && wxt zip",
    "zip:edge": "node scripts/copy-singlefile.js && wxt zip --browser edge",
    "zip:firefox": "node scripts/copy-singlefile.js && wxt zip --browser firefox --mv3",
    "zip:all": "npm run zip && npm run zip:edge && npm run zip:firefox",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.js",
    "dom-preprocessor:build": "node scripts/build-renderer-dom-preprocessor.js",
    "dom-preprocessor:check": "node scripts/build-renderer-dom-preprocessor.js --check",
    "api:generate": "cd ../backend && cargo run -p ind-http-api --example export_openapi -- ../extension/.openapi.tmp.json && cd ../extension && rm -rf lib/api/generated && openapi-ts -i .openapi.tmp.json -o lib/api/generated && prettier --write 'lib/api/generated/**/*.ts' && rm -f .openapi.tmp.json",
    "lint": "eslint .",
    "lint:firefox": "npx --yes web-ext lint --source-dir .output/firefox-mv3",
    "verify:stores": "node scripts/verify-store-artifacts.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare && node scripts/copy-singlefile.js"
  },
  "dependencies": {
    "defuddle": "^0.18.1",
    "single-file-core": "^1.3.51"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "jsdom": "^29.0.1",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.20"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "shell-quote": "^1.8.4",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "adm-zip": "^0.6.0",
    "tmp": "^0.2.6"
  }
}

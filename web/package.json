{
	"name": "indelible-web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"pnpm": {
		"overrides": {
			"js-yaml@4": "^4.3.0",
			"brace-expansion@5": "^5.0.8",
			"cookie@<0.7.0": "^0.7.2"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"validate": "pnpm check && pnpm lint && pnpm format:check && pnpm test",
		"api:generate": "cd ../backend && cargo run -p ind-http-api --example export_openapi -- ../web/.openapi.tmp.json && cd ../web && rm -rf src/lib/api/generated && openapi-ts -i .openapi.tmp.json -o src/lib/api/generated && pnpm exec prettier --write 'src/lib/api/generated/**/*.ts' && rm -f .openapi.tmp.json"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@hey-api/openapi-ts": "^0.97.3",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"eslint-plugin-svelte-runes": "^0.0.11",
		"globals": "^16.5.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^6.4.3",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"dompurify": "^3.4.13",
		"marked": "^18.0.7",
		"pdfjs-dist": "^5.7.284"
	}
}
